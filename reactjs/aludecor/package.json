{
  "name": "aludecor",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "node server.js",
    "lint": "next lint",
    "staging": "pm2 start yarn --name 'aludecor-server-staging' --interpreter bash -- start",
