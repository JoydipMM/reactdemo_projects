    "aos": "^2.3.4",
    "dotenv": "^16.4.7",
    "framer-motion": "^12.4.2",
    "gsap": "^3.12.7",
    "lucide-react": "^0.474.0",
    "motion": "^12.0.6",
    "next": "^15.3.2",
    "next-auth": "^4.24.11",
    "nprogress": "^0.2.0",
    "pm2": "^5.4.3",
    "react": "^19.0.0",
    "react-compare-image": "^3.5.0",
    "react-countup": "^6.5.3",
    "react-datepicker": "^8.1.0",
    "react-dom": "^19.0.0",
    "react-intersection-observer": "^9.15.1",
