<%- include("common/header") -%>
<div class="userflow-body-wrap">
    <div class="container">
<h2>Users List</h2>
<a href="/useradd" class="btn btn-primary">Add New</a>
<% if(message){  %>
<%= message %>
<% } %>
<table class="table">
    <tr>
        <th>ID</th>
        <th>Name</th>
        <th>Email</th>
        <th>Phone</th>
        <th>Action</th>
    </tr>
    <% let srno = pagingCounter %>
    <% userlist.forEach((user)=>{ %>
    <tr>
        <td><%= srno++ %></td>
        <td><%= user.name %></td>
        <td><%= user.email %></td>
        <td><%= user.phone %></td>
        <td>
            <a href="userview/<%= user.id %>">View</a>
            <a href="useredit/<%= user.id %>">Edit</a>
            <a href="userdelete/<%= user.id %>">Delete</a>
        </td>
    </tr>
    <% }) %>
</table>
   <nav>
    <ul class="pagination justify-content-center">
        <% if(!hasPrevPage){ %>
            <li class="page-item disabled"><a class="page-link" href="#">Previous</a></li>
        <% }else{ %>
            <li class="page-item"><a class="page-link" href="/userslist/?page=<%= prevPage %>">Previous</a></li>
        <% } %>
        <% for(let i=1; i <= totalPages; i++){ %>
            <% let activeclass = currentPage === i ? "active" : "" %>
            <li class="page-item <%= activeclass  %>"><a class="page-link" href="/userslist/?page=<%= i %>"><%= i %></a></li>
        <% } %>
        <% if(!hasNextPage){ %>
            <li class="page-item disabled"><a class="page-link" href="#">Next</a></li>
        <% }else{ %>
            <li class="page-item"><a class="page-link" href="/userslist/?page=<%= nextPage %>">Next</a></li>
        <% } %>
        
    </ul>
    </nav>

</div>
</div>
<%- include("common/footer") -%>