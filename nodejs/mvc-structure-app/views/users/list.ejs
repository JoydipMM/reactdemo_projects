<%- include("common/header") -%>
<div class="userflow-body-wrap">
    <div class="container">
<h2>Users List</h2>
<a href="/useradd" class="btn btn-primary">Add New</a>
<% if(message){  %>
<%= message %>
<% } %>
<table class="table">
    <tr>
        <th>ID</th>
        <th>Name</th>
        <th>Email</th>
        <th>Phone</th>
        <th>Action</th>
    </tr>
    <% userlist.forEach((user)=>{ %>
    <tr>
        <td>1</td>
        <td><%= user.name %></td>
        <td><%= user.email %></td>
        <td><%= user.phone %></td>
        <td>
            <a href="userview/<%= user.id %>">View</a>
            <a href="useredit/<%= user.id %>">Edit</a>
            <a href="userdelete/<%= user.id %>">Delete</a>
        </td>
    </tr>
    <% }) %>
</table>
   

</div>
</div>
<%- include("common/footer") -%>