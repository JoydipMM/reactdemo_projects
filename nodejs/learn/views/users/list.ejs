<%- include("common/header") -%>
<h2>Users List</h2>

<table class="table">
    <tr>
        <th>ID</th>
        <th>Name</th>
        <th>Email</th>
        <th>Phone</th>
        <th>Action</th>
    </tr>
    <% userslist.forEach((user)=>{ %>
    <tr>
        <td>1</td>
        <td><%= user.name %></td>
        <td><%= user.email %></td>
        <td><%= user.phone %></td>
        <td>
            <a href="userview/<%= user.id %>">View</a>
            <a href="#">Edit</a>
            <a href="#">Delete</a>
        </td>
    </tr>
    <% }) %>
</table>
    
<%- include("common/footer") -%>